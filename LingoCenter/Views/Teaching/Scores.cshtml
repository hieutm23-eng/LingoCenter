@model CenterClass
@{ViewBag.Title="Bảng điểm "+Model.Code;var students=Model.Enrollments.Where(e=>e.Status==EnrollmentStatus.Studying||e.Status==EnrollmentStatus.Completed).OrderBy(e=>e.Student.FullName).ToList();}
<div class="heading">
<div>
<div class="eyebrow">ASSESSMENT & FEEDBACK</div>
<h1>Bảng điểm · @Model.Code</h1>
<p>Thang điểm 10. Giữa kỳ 40%, cuối kỳ 60%. Lưu nháp sẽ ẩn điểm khỏi học viên.</p>
</div>
<a href="@Url.Action("Class",new{id=Model.Id})">← Về lớp</a>
</div>
<div class="panel">
<form method="post">
@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Học viên</th>
<th>Giữa kỳ</th>
<th>Cuối kỳ</th>
<th>Tổng kết</th>
<th>Công bố</th>
</tr>
</thead>
<tbody>
@for(int i=0;i<students.Count;i++){var e=students[i];<tr>
<td>@e.Student.FullName<input type="hidden" name="rows[@i].EnrollmentId" value="@e.Id"/>
</td>
<td>
<input aria-label="Điểm giữa kỳ @e.Student.FullName" name="rows[@i].Midterm" type="number" min="0" max="10" step="0.01" value="@e.Midterm"/>
</td>
<td>
<input aria-label="Điểm cuối kỳ @e.Student.FullName" name="rows[@i].Final" type="number" min="0" max="10" step="0.01" value="@e.Final"/>
</td>
<td class="score">@(e.Result.HasValue?e.Result.Value.ToString("0.00"):"—")</td>
<td>@(e.ScoresPublished?"Đã công bố":"Bản nháp")</td>
</tr>}
</tbody>
</table>
</div>
@if(students.Any()){<div class="actions" style="margin-top:20px">
<button class="secondary" name="publish" value="false">Lưu bản nháp</button>
<button name="publish" value="true">Lưu & công bố điểm</button>
</div>}else{<p class="empty">Chưa có học viên đang học hoặc đã hoàn thành.</p>}
</form>
</div>
