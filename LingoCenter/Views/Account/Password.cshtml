@model PasswordVm
@{ViewBag.Title="Đổi mật khẩu";}
<div class="heading">
<h1>Đổi mật khẩu</h1>
</div>
<div class="panel" style="max-width:650px">
@using(Html.BeginForm()){
@Html.AntiForgeryToken()
@Html.ValidationSummary(false)<div class="field">@Html.LabelFor(m=>m.CurrentPassword,"Mật khẩu hiện tại")@Html.PasswordFor(m=>m.CurrentPassword)</div>
<div class="field">@Html.LabelFor(m=>m.NewPassword,"Mật khẩu mới (ít nhất 10 ký tự)")@Html.PasswordFor(m=>m.NewPassword)</div>
<div class="field">@Html.LabelFor(m=>m.ConfirmPassword,"Xác nhận mật khẩu")@Html.PasswordFor(m=>m.ConfirmPassword)</div>
<button>Đổi mật khẩu</button>}
</div>
